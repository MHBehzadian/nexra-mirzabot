<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#11000000"
            android:padding="12dp"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pairing_hint"
            android:paddingTop="18dp"
            android:paddingBottom="6dp"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/pairing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="NXP1...."
            android:inputType="textMultiLine"
            android:minLines="2"
            android:textDirection="ltr"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/btnPair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pair" />

        <Button
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/test" />

        <Button
            android:id="@+id/btnScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scan" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/battery" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/senders_hint"
            android:paddingTop="18dp"
            android:paddingBottom="6dp"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/senders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="BANK,Mellat,۲۰۰۰..."
            android:inputType="text"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/btnSenders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_senders" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/log_title"
            android:paddingTop="18dp"
            android:paddingBottom="6dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#11000000"
            android:padding="12dp"
            android:textSize="13sp"
            android:fontFamily="monospace" />
    </LinearLayout>
</ScrollView>
